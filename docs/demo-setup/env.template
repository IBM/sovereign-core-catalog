# BYOP Demo Stack — Environment Variables Template
#
# Copy this file to .env and fill in all values before running any deployment phase.
# Source it before running any phase script:
#
#   source .env
#
# Variables are grouped by the phase that first requires them.
# Variables shared across multiple phases are defined once under the phase
# where they are first set.
#
# ─────────────────────────────────────────────────────────────────────────────
# PHASE 0 — Quay Registry
# ─────────────────────────────────────────────────────────────────────────────

# OpenShift application domain — used to construct all route and registry URLs
# Example: apps.mycluster.example.com
export CLUSTER_DOMAIN=""

# Quay registry hostname
# Example: registry-quay-quay-enterprise.apps.mycluster.example.com
export QUAY_REGISTRY=""

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1 — Gitea
# ─────────────────────────────────────────────────────────────────────────────

# Quay robot account token for the gitea org  (gitea+gitea_push)
# Obtain from: Quay UI → gitea organisation → Robot Accounts
export GITEA_ROBOT_TOKEN=""

# Gitea admin user password (chosen during admin user creation)
export GITEA_PASSWORD=""

# Gitea admin user email
export GITEA_EMAIL=""

# Local path to the Ed25519 private key registered in Gitea
# Generate with: ssh-keygen -t ed25519 -f ~/.ssh/gitea_ed25519
export GITEA_SSH_KEY_PATH="~/.ssh/gitea_ed25519"

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1 — Gitea OUTPUTS  (populated by show-gitea-outputs.sh after deploy)
# ─────────────────────────────────────────────────────────────────────────────

# Cluster node IP used as the Gitea SSH endpoint
export GITEA_HOST=""

# NodePort exposing the Gitea SSH service
export GITEA_SSH_PORT=""

# Numeric Linux UID of the Gitea process — used in the SSH repository URL
export GITEA_USER_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 2 — GitOps Repository
# ─────────────────────────────────────────────────────────────────────────────

# Registry hostname written into image-mapping.txt as the render-time substitution target.
# In a standard deployment this is always the same registry as QUAY_REGISTRY.
# Override only if you are targeting a different registry for mirrored service images.
export BYOP_REGISTRY="${QUAY_REGISTRY}"

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 3 — ArgoCD
# ─────────────────────────────────────────────────────────────────────────────

# Quay robot account token for the argoproj org  (argoproj+argocd_push)
# Obtain from: Quay UI → argoproj organisation → Robot Accounts
export ARGOCD_ROBOT_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 4 — BYOP Broker
# ─────────────────────────────────────────────────────────────────────────────

# Quay robot account token for the byop org  (byop+byop_push)
# Obtain from: Quay UI → byop organisation → Robot Accounts
export BYOP_ROBOT_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# CLUSTER OUTPUTS  (discovered automatically — do not set manually)
# These are printed by the show-*-outputs.sh scripts after each phase.
# Copy the exported values printed to stdout and add them here for
# use in subsequent phases.
# ─────────────────────────────────────────────────────────────────────────────

# Phase 1 outputs — printed by gitea/show-gitea-outputs.sh
# GITEA_HOST, GITEA_SSH_PORT, GITEA_USER_ID are defined above (they must be set before Phase 2).
# export GITEA_ROUTE_HOST=""     # Gitea web UI URL (informational only)

# Phase 3 outputs — printed by argocd/show-argocd-outputs.sh
# export ARGOCD_ROUTE_HOST=""    # ArgoCD web UI URL
# export ARGOCD_ADMIN_PASSWORD="" # ArgoCD initial admin password

# Phase 4 outputs — printed by broker/show-broker-outputs.sh
# export BROKER_ROUTE_HOST=""    # Broker route URL — needed for SovereignCore registration (Phase 5)
# export CATALOG_APP_ROUTE_HOST="" # Catalog app route URL (informational)
