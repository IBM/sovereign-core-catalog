{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "{{ display }} Instance Parameters",
  "description": "Parameters for provisioning a {{ display }} instance",
  "properties": {
    "cluster_url": {
      "type": "string",
      "description": "Target cluster server URL (optional, defaults to broker's cluster). Must be a registered ArgoCD cluster.",
      "format": "uri",
      "pattern": "^https://.*",
      "examples": [
        "https://kubernetes.default.svc",
        "https://192.168.2.89:6443"
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
