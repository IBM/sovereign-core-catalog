# BYOP Product Import Environment
# Copy this file and fill in values before running import.sh <product_name>

# ---------------------------------------------------------------------------
# External catalog repo — source of product directories (public, no auth required)
# ---------------------------------------------------------------------------
EXT_CATALOG_REPO=
EXT_CATALOG_BRANCH=main
EXT_CATALOG_PREFIX=components/software/open-source

# ---------------------------------------------------------------------------
# Product source credentials
# PRODUCT_SOURCE_TOKEN: PAT for cloning the chart source repo (helm-git only)
#   Leave empty if the chart source repo is public
# PRODUCT_SOURCE_KEY: registry credential (user:password) for helm registry
#   login when pulling a chart from a private OCI registry (helm-registry only)
#   Leave empty to attempt unauthenticated pull
# ---------------------------------------------------------------------------
PRODUCT_SOURCE_TOKEN=
PRODUCT_SOURCE_KEY=

# ---------------------------------------------------------------------------
# Product registry credentials
# Used as source credentials when mirroring images with skopeo
# Format: username:password
# Leave empty to attempt unauthenticated pull (e.g. public registries)
# ---------------------------------------------------------------------------
PRODUCT_REGISTRY_KEY=

# ---------------------------------------------------------------------------
# Target GitOps repo — destination for helm-git charts
# TARGET_TOKEN: PAT with read/write access to TARGET_REPO
# ---------------------------------------------------------------------------
TARGET_REPO=
TARGET_BRANCH=
TARGET_TOKEN=

# ---------------------------------------------------------------------------
# Quay registry credentials
# Used for helm registry login and skopeo copy destination
# ---------------------------------------------------------------------------
QUAY_USERNAME=quayadmin
QUAY_PASSWORD=

# ---------------------------------------------------------------------------
# ArgoCD namespace (defaults to openshift-gitops if unset)
# ---------------------------------------------------------------------------
ARGOCD_NAMESPACE=openshift-gitops

# ---------------------------------------------------------------------------
# Sovereign Core API key
# ---------------------------------------------------------------------------
SOVEREIGN_CORE_APIKEY=