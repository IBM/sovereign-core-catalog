{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-catalog.io/schemas/hardware-profile/v1alpha1",
  "title": "HardwareProfile",
  "description": "Schema for hardware vendor catalog entries in the Sovereign Store.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "sovereign-catalog.io/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "HardwareProfile"
    },
    "metadata": {
      "type": "object",
      "required": ["companyRef", "vendor", "product", "category", "lifecycleStatus", "storefrontVisibility"],
      "properties": {
        "companyRef": {
          "type": "string",
          "pattern": "^companies/[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Relative path to the canonical company profile (e.g. companies/amd)."
        },
        "vendor": {
          "type": "string",
          "description": "Legal entity name of the hardware vendor."
        },
        "product": {
          "type": "string",
          "description": "Product display name."
        },
        "shortDescription": {
          "type": "string",
          "description": "Short storefront summary for cards and carousel."
        },
        "fullDescription": {
          "type": "string",
          "description": "Longer product description for detail views."
        },
        "sovereignCoreRelevance": {
          "type": "string",
          "description": "Explanation of why this offering is relevant in sovereign or regulated environments."
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["government", "bfsi", "healthcare", "telco", "energy", "sovereign_ai", "vmware_modernization"]
          },
          "description": "Industry segments this offering is intended for."
        },
        "intendedUsers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Primary user roles or personas for this offering (e.g. Data scientists, AI engineers, Data architects, Compliance officers, Platform engineers)."
        },
        "category": {
          "type": "string",
          "enum": ["GPU", "CPU", "Storage", "Networking", "Server"],
          "description": "Hardware category."
        },
        "lifecycleStatus": {
          "type": "string",
          "enum": ["draft", "review", "approved", "deprecated", "retired"],
          "description": "Current lifecycle state of this catalog entry. Drives storefront visibility and deployment eligibility."
        },
        "storefrontVisibility": {
          "type": "string",
          "enum": ["public", "unlisted", "private"],
          "description": "Controls whether this entry appears in the public storefront (public), is accessible by direct link only (unlisted), or is hidden from all customers (private)."
        },
        "availabilityState": {
          "type": "string",
          "enum": ["available_central_it", "byop_ready", "technical_assets_available", "discoverable_only"],
          "description": "Semantic availability state for storefront display and fulfillment handling."
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["jurisdiction", "capabilities"],
      "properties": {
        "jurisdiction": {
          "type": "object",
          "required": ["hq"],
          "properties": {
            "hq": {
              "type": "string",
              "description": "Country/region where the vendor is headquartered."
            },
            "supplyChainAttestation": {
              "type": "string",
              "description": "Statement about supply chain transparency."
            }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "string",
              "description": "Memory specification (e.g., 192GB HBM3)."
            },
            "confidentialComputing": {
              "type": "object",
              "properties": {
                "supported": {
                  "type": "boolean"
                },
                "technology": {
                  "type": "string",
                  "description": "Confidential computing technology name."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "k8sIntegration": {
          "type": "object",
          "properties": {
            "devicePluginOci": {
              "type": "string",
              "description": "OCI URI for the Kubernetes device plugin."
            }
          },
          "additionalProperties": true
        },
        "links": {
          "type": "object",
          "properties": {
            "docsUrl": {
              "type": "string",
              "format": "uri",
              "description": "Public product documentation URL."
            },
            "productPageUrl": {
              "type": "string",
              "format": "uri",
              "description": "Canonical public product page URL."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
