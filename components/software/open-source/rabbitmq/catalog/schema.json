{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "RabbitMQ Instance Parameters",
  "description": "Parameters for provisioning a RabbitMQ instance",
  "properties": {
    "cluster_url": {
      "type": "string",
      "description": "Target cluster server URL (optional, defaults to broker's cluster). Must be a registered ArgoCD cluster.",
      "format": "uri",
      "pattern": "^https://.*",
      "examples": [
        "https://kubernetes.default.svc",
        "https://192.168.2.89:6443",
        "https://192.168.2.90:6443"
      ]
    },
    "username": {
      "type": "string",
      "description": "RabbitMQ default user name",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
      "minLength": 1,
      "maxLength": 64,
      "default": "appuser",
      "examples": ["appuser", "admin"]
    },
    "password": {
      "type": "string",
      "description": "RabbitMQ default user password. Auto-generated if not provided.",
      "minLength": 8,
      "maxLength": 128,
      "examples": ["SecureP@ssw0rd123"],
      "x-generate": {
        "type": "password",
        "length": 32,
        "include": "alphanumeric-symbols"
      }
    },
    "erlang_cookie": {
      "type": "string",
      "description": "Erlang cookie for RabbitMQ cluster authentication. Auto-generated if not provided.",
      "minLength": 8,
      "maxLength": 255,
      "x-generate": {
        "type": "password",
        "length": 32,
        "include": "alphanumeric"
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
