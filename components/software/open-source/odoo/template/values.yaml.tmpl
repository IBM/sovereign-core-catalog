# Helm values override for instance
namespaceOverride: {{ namespace }}

nameOverride: {{ instance_name }}
fullnameOverride: {{ instance_name }}

commonLabels:
  app: odoo
  service-type: odoo

commonAnnotations:
  sovcore.byop.ibm.com/crn: {{ context.crn | default("crn:unknown") | yaml_safe }}
  sovcore.byop.ibm.com/account-id: {{ context.account_id | default("unknown") | yaml_safe }}
  sovcore.byop.ibm.com/sub-account-id: {{ context.sub_account_id | default("unknown") | yaml_safe }}
  sovcore.byop.ibm.com/platform: {{ context.platform | default("unknown") | yaml_safe }}

instance:
  name: {{ instance_name }}
  id: "{{ instance_id }}"
  environment: {{ environment }}
  clusterName: "{{ cluster_name }}"

image:
  registry: BYOP_REGISTRY
  repository: byop/odoo
  # Overrides the image tag whose default is the chart appVersion.
  tag: "18.0"

imagePullSecrets:
{% if image_pull_secret_name %}
  - name: {{ image_pull_secret_name }}
{% else %}
  []
{% endif %}

# Odoo application configuration
odoo:
  # Odoo master/admin password
  admin_passwd: {{ spec.admin_password | yaml_safe }}
  
  # Database configuration
  db_name: {{ spec.database_name | yaml_safe }}
  
  # Worker configuration
  workers: {{ spec.workers | default(2) }}
  
  # Disable bundled PostgreSQL (we use the postgres subchart)
  postgresql:
    enabled: false

# External database configuration (connects to postgres subchart)
externalDatabase:
  host: {{ instance_name }}-postgres
  port: 5432
  name: {{ spec.database_name | yaml_safe }}
  user: {{ spec.database_user | yaml_safe }}
  password: {{ spec.database_password | yaml_safe }}

# Odoo persistent storage (filestore for attachments, sessions)
persistence:
  enabled: true
  size: {{ spec.storage_size | default("10Gi") }}
  # storageClass: "ceph-rbd-platform"
  accessMode: ReadWriteOnce

# OpenShift Route configuration
route:
  enabled: true

nginx:
  image:
    registry: BYOP_REGISTRY
    repository: byop/nginx
    tag: "1.29.8-alpine"

# PostgreSQL subchart configuration
postgres:
  enabled: true
  
  image:
    registry: BYOP_REGISTRY
    repository: byop/postgres
    tag: "13.12"

  # Database configuration
  settings:
    superuserPassword: {{ spec.postgres_superuser_password | yaml_safe }}
  
  # User database
  userDatabase:
    name: {{ spec.database_name | yaml_safe }}
    user: {{ spec.database_user | yaml_safe }}
    password: {{ spec.database_password | yaml_safe }}
  
  # PostgreSQL storage
  storage:
    requestedSize: {{ spec.postgres_storage_size | default("8Gi") }}
    # storageClass: "ceph-rbd-platform"
    accessModes:
      - ReadWriteOnce
