# Helm values override for Apache Kafka instance
namespaceOverride: {{ namespace }}

commonLabels:
  app: kafka
  service-type: kafka

commonAnnotations:
  sovcore.byop.ibm.com/crn: {{ context.crn | default("crn:unknown") | yaml_safe }}
  sovcore.byop.ibm.com/account-id: {{ context.account_id | default("unknown") | yaml_safe }}
  sovcore.byop.ibm.com/sub-account-id: {{ context.sub_account_id | default("unknown") | yaml_safe }}
  sovcore.byop.ibm.com/platform: {{ context.platform | default("unknown") | yaml_safe }}

instance:
  name: {{ instance_name }}
  id: "{{ instance_id }}"
  environment: {{ environment }}
  clusterName: "{{ cluster_name }}"

imagePullSecrets:
{% if image_pull_secret_name %}
  - name: {{ image_pull_secret_name }}
{% else %}
  []
{% endif %}

image:
  registry: BYOP_REGISTRY
  repository: byop/kafka
  tag: "4.0.0"

replicaCount: {{ spec.replica_count | default(1) }}

sasl:
  client:
    users:
      - appuser
    passwords: {{ spec.client_password | yaml_safe }}
  interbroker:
    user: interbroker
    password: {{ spec.inter_broker_password | yaml_safe }}

zookeeper:
  enabled: false

kraft:
  enabled: true

storage:
  requestedSize: {{ storage_size }}
  # className: "ceph-rbd-platform"
  accessModes:
    - ReadWriteOnce

resources:
  requests:
    cpu: 500m
    memory: 1Gi
  limits:
    cpu: 2000m
    memory: 2Gi
