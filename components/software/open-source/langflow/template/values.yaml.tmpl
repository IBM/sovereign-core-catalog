# Helm values override for Langflow IDE instance
namespaceOverride: {{ namespace }}

commonLabels:
  app: langflow
  service-type: langflow

commonAnnotations:
  sovcore.byop.ibm.com/crn: {{ context.crn | default("crn:unknown") | yaml_safe }}
  sovcore.byop.ibm.com/account-id: {{ context.account_id | default("unknown") | yaml_safe }}
  sovcore.byop.ibm.com/sub-account-id: {{ context.sub_account_id | default("unknown") | yaml_safe }}
  sovcore.byop.ibm.com/platform: {{ context.platform | default("unknown") | yaml_safe }}

instance:
  name: {{ instance_name }}
  id: "{{ instance_id }}"
  environment: {{ environment }}
  clusterName: "{{ cluster_name }}"

imagePullSecrets:
{% if image_pull_secret_name %}
  - name: {{ image_pull_secret_name }}
{% else %}
  []
{% endif %}

langflow:
  global:
    image:
      tag: "1.10.2"

  backend:
    image:
      # No registry/repository split in this chart — full ref goes in repository
      repository: BYOP_REGISTRY/byop/langflow
      tag: "1.10.2"

    superuser: {{ spec.superuser | default("admin@langflow.io") | yaml_safe }}
    superuserPassword: {{ spec.superuser_password | yaml_safe }}
    secretKey: {{ spec.secret_key | yaml_safe }}
    newUserIsActive: true
    autoLogin: false

    sqlite:
      enabled: true
      volume:
        size: {{ storage_size }}
        # existingStorageClassName: "ceph-rbd-platform"

  frontend:
    enabled: true
    image:
      repository: BYOP_REGISTRY/byop/langflow-frontend
      tag: "1.10.2"

route:
  enabled: true
