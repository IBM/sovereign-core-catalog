# Helm values override for etcd instance
namespaceOverride: {{ namespace }}

commonLabels:
  app: etcd
  service-type: etcd

commonAnnotations:
  sovcore.byop.ibm.com/crn: {{ context.crn | default("crn:unknown") | yaml_safe }}
  sovcore.byop.ibm.com/account-id: {{ context.account_id | default("unknown") | yaml_safe }}
  sovcore.byop.ibm.com/sub-account-id: {{ context.sub_account_id | default("unknown") | yaml_safe }}
  sovcore.byop.ibm.com/platform: {{ context.platform | default("unknown") | yaml_safe }}

instance:
  name: {{ instance_name }}
  id: "{{ instance_id }}"
  environment: {{ environment }}
  clusterName: "{{ cluster_name }}"

imagePullSecrets:
{% if image_pull_secret_name %}
  - name: {{ image_pull_secret_name }}
{% else %}
  []
{% endif %}

image:
  registry: BYOP_REGISTRY
  repository: byop/etcd
  tag: "v3.4.2"

initImage:
  registry: BYOP_REGISTRY
  repository: byop/busybox
  tag: "stable"


replicas: {{ replicas }}

settings:
  clusterToken: {{ spec.cluster_token | default("etcd-cluster-0") | yaml_safe }}

storage:
  requestedSize: {{ storage_size }}
  # className: "ceph-rbd-platform"
